# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Model weights (fetched by scripts/fetch_models.py; SHA256-pinned in DOWNLOADS.md)
models/
*.gguf
*.safetensors

# Local llama.cpp checkout + build (scripts/build_llamacpp.sh)
/vendor/

# Heavy run-time artifacts; the JSONL result shards ARE tracked
/results/**/*.log
/results/**/*.bak
.build_logs/

# LaTeX build artifacts (tectonic regenerates main.pdf)
paper/*.aux
paper/*.blg
paper/*.bbl
paper/*.log

# Local editing snapshots of the paper
paper/backup-*/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Agent-local state — never commit
.claude/

# Secrets
.env
*.env

# Internal live-status notes (kept out of the public artifact)
/HANDOFF.md
/PUBLISHING.md
/SUBMIT.md

# session scratch (reviews, plans, research notes) and latex aux
/tmp/
/paper/main.out
